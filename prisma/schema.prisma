model Periodo {
  periodo         String            @id
  Disponibilidade Disponibilidade[]
  TempoLectivo    TempoLectivo[]
}

model ProfDisciplinas {
  idProfDisciplina Int        @id @default(autoincrement())
  professorId      Int
  disciplinaId     Int
  Disciplina       Disciplina @relation(fields: [disciplinaId], references: [idDisciplina], onDelete: Cascade)
  Professor        Professor  @relation(fields: [professorId], references: [id_professor], onDelete: Cascade)

  @@unique([professorId, disciplinaId])
}

model ProfTurma {
  idProfTurma Int       @id @default(autoincrement())
  professorId Int
  turmaId     Int
  Professor   Professor @relation(fields: [professorId], references: [id_professor])
  Turma       Turma     @relation(fields: [turmaId], references: [idTurma])

  @@unique([professorId, turmaId])
}

model Sala {
  idSala       Int            @id @default(autoincrement())
  nome         String
  TempoLectivo TempoLectivo[]
}

model TempoLectivo {
  idTempoLectivo Int        @id @default(autoincrement())
  diaSemana      String
  periodoId      String
  ordem          Int
  professorId    Int
  disciplinaId   Int
  salaId         Int
  turmaId        Int
  DiaSemana      DiaSemana  @relation(fields: [diaSemana], references: [nome])
  Disciplina     Disciplina @relation(fields: [disciplinaId], references: [idDisciplina])
  Periodo        Periodo    @relation(fields: [periodoId], references: [periodo])
  Professor      Professor  @relation(fields: [professorId], references: [id_professor])
  Sala           Sala       @relation(fields: [salaId], references: [idSala])
  Turma          Turma      @relation(fields: [turmaId], references: [idTurma])
}

model Turma {
  idTurma      Int            @id @default(autoincrement())
  nome         String
  classe    String
  curso      String
  ProfTurma    ProfTurma[]
  TempoLectivo TempoLectivo[]
  Classe       Classe         @relation(fields: [classe], references: [nome])
  Curso        Curso          @relation(fields: [curso], references: [nome])
}

