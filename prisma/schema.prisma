generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Classe {
  //idClasse Int     @id @default(autoincrement())
  nome  String  @id
  Turma Turma[]
}

model Curso {
  nome  String  @id
  Turma Turma[]
}

model DiaSemana {
  nome            String            @id @unique
  Disponibilidade Disponibilidade[]
  TempoLectivo    TempoLectivo[]
}

model Disciplina {
  nome                String                @id
  ProfTurmaDisciplina ProfTurmaDisciplina[]
  //ProfDisciplinas ProfDisciplinas[]
  TempoLectivo        TempoLectivo[]
}

model Disponibilidade {
  idDisponibilidade Int       @id @default(autoincrement())
  diaSemana         String
  periodo           String
  ordem             Int
  professorId       Int
  DiaSemana         DiaSemana @relation(fields: [diaSemana], references: [nome])
  Periodo           Periodo   @relation(fields: [periodo], references: [periodo])
  Professor         Professor @relation(fields: [professorId], references: [id_professor])
}

/**
 * model Admin {
 * id_admin   Int        @id @default(autoincrement())
 * id_Usuario Int        @unique
 * created_at DateTime   @default(now())
 * updated_at DateTime
 * Utilizador Utilizador @relation(fields: [id_Usuario], references: [id], onDelete: Cascade)
 * }
 * model Aluno {
 * id_aluno      Int        @id @default(autoincrement())
 * id_Usuario    Int        @unique
 * num_matricula String
 * created_at    DateTime   @default(now())
 * updated_at    DateTime
 * Utilizador    Utilizador @relation(fields: [id_Usuario], references: [id])
 * }
 */

model Professor {
  id_professor        Int                   @id @default(autoincrement())
  nome                String
  email               String?
  telefone            String?
  //id_Usuario      Int               @unique
  //disciplina_principal String
  created_at          DateTime              @default(now())
  updated_at          DateTime
  Disponibilidade     Disponibilidade[]
  //Utilizador      Utilizador        @relation(fields: [id_Usuario], references: [id])
  //ProfDisciplinas ProfDisciplinas[]
  ProfTurmaDisciplina ProfTurmaDisciplina[]
  TempoLectivo        TempoLectivo[]
}

/**
 * model Utilizador {
 * id         Int        @id @default(autoincrement())
 * workos_id  String?    @unique
 * nome       String
 * email      String?    @unique
 * tipo       UserType
 * created_at DateTime   @default(now())
 * updated_at DateTime
 * Admin      Admin?
 * Aluno      Aluno?
 * Professor  Professor?
 * }
 */

model Periodo {
  periodo         String            @id
  Disponibilidade Disponibilidade[]
  TempoLectivo    TempoLectivo[]
}

/**
 * model ProfDisciplinas {
 * idProfDisciplina Int        @id @default(autoincrement())
 * professorId      Int
 * disciplina     String
 * Disciplina       Disciplina @relation(fields: [disciplina], references: [nome], onDelete: Cascade)
 * Professor        Professor  @relation(fields: [professorId], references: [id_professor], onDelete: Cascade)
 * @@unique([professorId, disciplina])
 * }
 */
model ProfTurmaDisciplina {
  idProfTurma    Int        @id @default(autoincrement())
  professorId    Int
  turmaId        Int
  disciplinaNome String
  disciplina     Disciplina @relation(fields: [disciplinaNome], references: [nome])
  Professor      Professor  @relation(fields: [professorId], references: [id_professor])
  Turma          Turma      @relation(fields: [turmaId], references: [idTurma])

  @@unique([professorId, turmaId, disciplinaNome])
}

model TurmaDisciplina {
  id_Turma   Int
  Disciplina String
  Turma      Turma  @relation(fields: [id_Turma], references: [idTurma])

  @@id([id_Turma, Disciplina])
}

model Sala {
  idSala       Int            @id @default(autoincrement())
  nome         String
  TempoLectivo TempoLectivo[]
}

model TempoLectivo {
  idTempoLectivo Int        @id @default(autoincrement())
  diaSemana      String
  periodoId      String
  ordem          Int
  professorId    Int
  disciplina     String
  salaId         Int
  turmaId        Int
  DiaSemana      DiaSemana  @relation(fields: [diaSemana], references: [nome])
  Disciplina     Disciplina @relation(fields: [disciplina], references: [nome])
  Periodo        Periodo    @relation(fields: [periodoId], references: [periodo])
  Professor      Professor  @relation(fields: [professorId], references: [id_professor])
  Sala           Sala       @relation(fields: [salaId], references: [idSala])
  Turma          Turma      @relation(fields: [turmaId], references: [idTurma])
}

model Turma {
  idTurma             Int                   @id @default(autoincrement())
  nome                String
  classe              String
  curso               String
  ProfTurmaDisciplina ProfTurmaDisciplina[]
  TempoLectivo        TempoLectivo[]
  TurmaDisciplina     TurmaDisciplina[]
  Classe              Classe                @relation(fields: [classe], references: [nome])
  Curso               Curso                 @relation(fields: [curso], references: [nome])
}

/**
 * enum UserType {
 * Admin
 * Professor
 * Aluno
 * }
 */
