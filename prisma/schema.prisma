// ════════════════════════════════════════════════════════════
//  PRISMA SCHEMA — Portal de Horários Académicos
// ════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Classe {
  nome_classe String @db.VarChar(20) @id

  turmas Turma[]

  @@map("classes")
}

model Curso {
  nome_curso String @db.VarChar(100) @id

  turmas Turma[]

  @@map("cursos")
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
}

model Disciplina {
  nome_disciplina String @db.VarChar(100) @id

  turmaDisciplinas    TurmaDisciplina[]
  profTurmaDisciplina ProfTurmaDisciplina[]
  tempo_lectivo       Tempo_Lectivo[]

  @@map("disciplinas")
}

model Disponibilidade {
  id_disponibilidade          Int @id @default(autoincrement())
  id_professor                Int
  nome_dia                    DiaSemana
  nome_periodo                Periodo
  ordem                       Int

  professor Professor @relation(fields: [id_professor], references: [id_professor])

  @@map("disponibilidades")
}

enum Periodo {
  MANHA
  TARDE
}

model Professor {
  id_professor Int      @id @default(autoincrement())
  nome         String   @db.VarChar(100)
  email        String   @db.VarChar(100) 
  telefone     String   @db.VarChar(15)
  updated_at   DateTime @updatedAt

  profTurmaDisciplina       ProfTurmaDisciplina[]
  disponibilidades          Disponibilidade[]
  tempo_lectivo             Tempo_Lectivo[]

  @@map("professores")
}

model ProfTurmaDisciplina {
  id_professor    Int
  nome_turma      String
  nome_disciplina String

  disciplina     Disciplina @relation(fields: [nome_disciplina], references: [nome_disciplina])
  professor      Professor  @relation(fields: [id_professor], references: [id_professor])
  turma          Turma      @relation(fields: [nome_turma], references: [nome_turma])

  @@id([id_professor, nome_turma, nome_disciplina])
  @@map("prof_turma_disciplinas")
}

model Sala {
  nome_sala       String @db.VarChar(20) @id
  capacidade      Int

  tempo_lectivo Tempo_Lectivo[]

  @@map("salas")
}

model Tempo_Lectivo {
  id_tempoLectivo   Int    @id @default(autoincrement())
  id_professor      Int
  nome_turma        String @db.VarChar(20)
  nome_disciplina   String @db.VarChar(100)
  nome_sala         String @db.VarChar(20)
  nome_dia          DiaSemana
  nome_periodo      Periodo
  ordem             Int

  professor  Professor  @relation(fields: [id_professor], references: [id_professor])
  turma      Turma      @relation(fields: [nome_turma], references: [nome_turma])
  disciplina Disciplina @relation(fields: [nome_disciplina], references: [nome_disciplina])
  sala       Sala       @relation(fields: [nome_sala], references: [nome_sala])

  @@map("tempo_lectivo")
} 

model Turma {
  nome_turma     String @db.VarChar(20) @id
  nome_curso     String @db.VarChar(20)
  nome_classe    String @db.VarChar(20)

  curso    Curso     @relation(fields: [nome_curso], references: [nome_curso])
  classe   Classe    @relation(fields: [nome_classe], references: [nome_classe])

  profTurmaDisciplina ProfTurmaDisciplina[]
  turmaDisciplinas    TurmaDisciplina[]
  tempo_lectivo       Tempo_Lectivo[]

  @@map("turmas")
}

model TurmaDisciplina {
  nome_turma        String @db.VarChar(20)
  nome_disciplina   String @db.VarChar(100)
  aulas_por_semana  Int

  turma      Turma  @relation(fields: [nome_turma], references: [nome_turma])
  disciplina Disciplina @relation(fields: [nome_disciplina], references: [nome_disciplina])

  @@id([nome_turma, nome_disciplina])
  @@map("turma_disciplinas")
}