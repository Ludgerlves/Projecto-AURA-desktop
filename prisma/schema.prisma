generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Classe {
  //idClasse Int     @id @default(autoincrement())
  nome     String @id
  Turma    Turma[]
}

model Curso {
  
  nome    String @id
  Turma   Turma[]
}

model DiaSemana {
  nome            String            @unique @id
  Disponibilidade Disponibilidade[]
  TempoLectivo    TempoLectivo[]
}

model Disciplina {
  idDisciplina    Int               @id @default(autoincrement())
  nome            String
  ProfDisciplinas ProfDisciplinas[]
  TempoLectivo    TempoLectivo[]
}

model Disponibilidade {
  idDisponibilidade Int       @id @default(autoincrement())
  diaSemana      String
  periodoId         String
  ordem             Int
  professorId       Int
  DiaSemana         DiaSemana @relation(fields: [diaSemana], references: [nome])
  Periodo           Periodo   @relation(fields: [periodoId], references: [periodo])
  Professor         Professor @relation(fields: [professorId], references: [id_professor])
}

