  email String ?
  telefone String?
  //id_Usuario      Int               @unique
  //disciplina_principal String
  created_at      DateTime          @default(now())
  updated_at      DateTime
  Disponibilidade Disponibilidade[]
  //Utilizador      Utilizador        @relation(fields: [id_Usuario], references: [id])
  ProfDisciplinas ProfDisciplinas[]
